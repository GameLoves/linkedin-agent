# ---------------------------------------------------------------------------
# LinkedIn posting agent configuration.
# Copy this file to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Claude API (drafting) -------------------------------------------------
# Create a key at https://console.anthropic.com/  (Settings > API keys)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Model used to write posts. Default is the current most capable Opus model.
CLAUDE_MODEL=claude-opus-5-5
# Thinking depth: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Let Claude search the web for fresh trends (requires web search enabled
# for your Anthropic organization; adds a small per-search cost).
USE_WEB_SEARCH=false

# --- Your voice ------------------------------------------------------------
AUTHOR_NAME=Mohammad Dawood Saddiqi
AUTHOR_ROLE=Software Engineer at Ghalib Software Service Company
# Free-text description of your style; Claude follows it when writing.
AUTHOR_STYLE=Practical, honest, and friendly. Shares lessons from real projects. Avoids hype and buzzwords.
POST_LANGUAGE=English
# Topic areas used when picking trending subjects (comma separated).
TOPIC_AREAS=artificial intelligence,software engineering,computer science,databases,security,developer tools

# --- LinkedIn API (publishing) ---------------------------------------------
# From your app at https://www.linkedin.com/developers/apps  (Auth tab)
LINKEDIN_CLIENT_ID=REPLACE_ME
LINKEDIN_CLIENT_SECRET=REPLACE_ME
# Must exactly match an "Authorized redirect URL" in your LinkedIn app.
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback
# LinkedIn API version (YYYYMM). Versions sunset after about one year;
# update this when LinkedIn announces a sunset.
LINKEDIN_API_VERSION=202609
# true = log what would be posted, never call LinkedIn's write endpoints.
LINKEDIN_DRY_RUN=true

# --- Storage ---------------------------------------------------------------
# Folder for the SQLite database and the saved LinkedIn token.
DATA_DIR=./data
# Time zone used when you type schedule times (IANA name).
TIMEZONE=Asia/Kabul
